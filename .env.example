# ==============================================================================
# Skyshare Academy Portal - Client Environment Configuration
# ==============================================================================
# API Base URL (Required for production builds; in DEV mode defaults to http://localhost:3002)
# Example dev/staging: http://localhost:3002 or https://api-dev.skyshareacademy.id
VITE_API_BASE_URL=http://localhost:3002

# Google OAuth 2.0 Web Client ID (Required for Google Identity Services GIS button)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
